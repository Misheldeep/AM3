#!/bin/sh

NAME=peugeot-bridge
SUPERVISOR=/usr/sbin/peugeot-bridge-supervisor
SUP_PIDFILE=/run/peugeot-bridge-supervisor.pid
CHILD_PIDFILE=/run/peugeot-bridge.pid

is_alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

pid_from_file() {
    [ -r "$1" ] || return 1
    cat "$1" 2>/dev/null
}

start_service() {
    pid="$(pid_from_file "$SUP_PIDFILE" 2>/dev/null || true)"
    if is_alive "$pid"; then
        echo "$NAME already running (supervisor PID $pid)"
        return 0
    fi

    rm -f "$SUP_PIDFILE" "$CHILD_PIDFILE"

    if pidof carberryd >/dev/null 2>&1; then
        echo "ERROR: carberryd is running and owns /dev/ttyAMA0"
        echo "Stop carberryd before starting $NAME."
        return 1
    fi

    echo -n "Starting $NAME: "
    start-stop-daemon --start --background -m \
        --pidfile "$SUP_PIDFILE" --exec "$SUPERVISOR"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "OK"
    else
        echo "FAILED ($rc)"
    fi
    return "$rc"
}

stop_service() {
    pid="$(pid_from_file "$SUP_PIDFILE" 2>/dev/null || true)"
    echo -n "Stopping $NAME: "

    if is_alive "$pid"; then
        kill -TERM "$pid" 2>/dev/null || true
        i=0
        while is_alive "$pid" && [ "$i" -lt 7 ]; do
            sleep 1
            i=$((i + 1))
        done
        if is_alive "$pid"; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi

    # Safety cleanup if the supervisor died without reaping its child.
    cpid="$(pid_from_file "$CHILD_PIDFILE" 2>/dev/null || true)"
    if is_alive "$cpid"; then
        kill -TERM "$cpid" 2>/dev/null || true
        sleep 1
        is_alive "$cpid" && kill -KILL "$cpid" 2>/dev/null || true
    fi

    rm -f "$SUP_PIDFILE" "$CHILD_PIDFILE" /run/peugeot-bridge.sock
    echo "OK"
}

status_service() {
    pid="$(pid_from_file "$SUP_PIDFILE" 2>/dev/null || true)"
    cpid="$(pid_from_file "$CHILD_PIDFILE" 2>/dev/null || true)"

    if is_alive "$pid"; then
        echo "$NAME supervisor: running PID $pid"
        if is_alive "$cpid"; then
            echo "$NAME bridge:     running PID $cpid"
        else
            echo "$NAME bridge:     restarting/not running"
        fi
        return 0
    fi

    echo "$NAME: stopped"
    return 1
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        start_service
        ;;
    status)
        status_service
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
